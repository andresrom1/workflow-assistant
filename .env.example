APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=workflow_assistant
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudflare R2 (S3-compatible)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=https://{ACCOUNT_ID}.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-{HASH}.r2.dev

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Firebase (Admin SDK kreait) — verificación de ID Tokens de la app móvil.
# FIREBASE_CREDENTIALS = ruta absoluta al JSON del service account (NO commitear el JSON).
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Vinculación de identidad — solo para test end-to-end del claim en dev.
# Crea un tomador (Customer) con TU email OAuth real así el match funciona.
MANGO_DEV_CUSTOMER_EMAIL=
MANGO_DEV_CUSTOMER_DNI=

# PAS por default del aviso de Siniestro (spec v2 §4.2). Último recurso de la
# prelación: PAS propio → PAS del titular del vehículo compartido → este.
# Debe ser el email de un User con role=pas. En dev suele ser tu PAS de pruebas.
MANGO_DEFAULT_PAS_EMAIL=

# Mock laxo de matcheo de Customer (fase mock). En true, una cuenta sin linking
# por DNI igual ve sus pólizas si el email matchea un Customer. Con la API real:
# poné false → solo vale el linking estricto. Único switch del des-mockeo (F10).
MANGO_MOCK_CUSTOMER_MATCHING=true

# Visred API (cotización + emisión real) — refactor v2.
# Visred es EL proveedor: bind directo en AppServiceProvider, sin selector.
# El día que entre un 2º proveedor → una sola clave INSURANCE_PROVIDER (array).
# Credenciales de servicio del productor MANGO. NO commitear valores reales.
VISRED_BASE_URL=https://sandbox-api.visred.com.ar
VISRED_USERNAME=
VISRED_PASSWORD=
VISRED_TIMEOUT=30
VISRED_POLL_BUDGET=120
VISRED_POLL_INTERVAL=4
# X-Mock-Scenario solo se envía con VISRED_SANDBOX=true (en prod → 403). Ver docs/v2/08.
VISRED_SANDBOX=false
