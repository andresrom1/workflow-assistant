      "Bash(python -c \"import sys,json; d=json.load\\(sys.stdin\\); print\\(json.dumps\\(d.get\\(''''require'''',{}\\), indent=2\\)\\)\")",
      "Bash(cp:*)",
      "Bash(git add:*)",
      "Bash(winget list:*)",
      "Bash(where gh:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
