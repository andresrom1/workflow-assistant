# Evita hornear secretos y artefactos pesados en la imagen (el Dockerfile hace COPY . .).
# El entorno se inyecta en runtime vía env_file de Compose, no dentro de la imagen.

# Secretos / entorno
.env
.env.*
!.env.example
auth.json

# Dependencias reconstruidas dentro de la imagen
/vendor
/node_modules

# Cache de bootstrap generada en la maquina de desarrollo. Si se hornea en la imagen,
# `packages.php` lista providers de dependencias de DEV (Laravel Boost) que
# `composer install --no-dev` no instala, y cualquier `php artisan` revienta con
# "Class Laravel\Boost\BoostServiceProvider not found" — incluido el `migrate` de start.sh.
# En la VM no se nota porque el archivo esta gitignoreado y no existe tras un `git pull`;
# se nota solo al buildear desde una maquina de desarrollo. El Dockerfile recrea el
# directorio con `mkdir -p bootstrap/cache`.
/bootstrap/cache

# Certificados y almacenamiento privado (van en volumen persistente, no en la imagen)
/storage/app/certs/*
!/storage/app/certs/.gitkeep
/storage/*.key
/storage/logs/*
/storage/pail

# Git y herramientas de dev
.git
.github
/.idea
/.vscode
/.zed
/.fleet
/.nova
/.phpunit.cache
/.phpstan-tmp
/.rector-cache
.phpunit.result.cache

# Tests y docs no necesarios en runtime
/tests
*.log
*.old
Thumbs.db
.DS_Store

# Config local de Claude
.claude/settings.local.json
.claude/worktrees/
