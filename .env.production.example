# Plantilla de entorno de PRODUCCIÓN (Oracle Cloud, self-host con compose.prod.yaml).
# Copiar a .env.production (gitignored) y completar. NO commitear valores reales.
# Compose lo usa como única fuente: docker compose --env-file .env.production -f compose.prod.yaml ...

APP_NAME="MANGO Seguros"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mangoseguros.com.ar

# Dominio para compose (interpolación) y Caddy (TLS automático). Sin esquema.
APP_DOMAIN=mangoseguros.com.ar

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# PostgreSQL con pgvector (servicio 'postgres' de compose.prod.yaml).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=workflow_assistant
DB_USERNAME=mango
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.mangoseguros.com.ar

# Reverb retirado: sin broadcasting (resultados async van por el pipeline WhatsApp).
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# Cloudflare R2 (S3-compatible) — fotos de checkout y documentos de coberturas.
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=https://{ACCOUNT_ID}.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-{HASH}.r2.dev

# WhatsApp Cloud API — webhook en https://mangoseguros.com.ar/api/webhooks/whatsapp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DISPATCH_DRIVER=cloud

# Landing pública
WHATSAPP_PUBLIC_NUMBER=
MANGO_APP_DOWNLOAD_URL=

# AI Providers — FIJAR LÍMITE DE GASTO en el dashboard de OpenAI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Firebase Admin SDK — verificación de ID Tokens de la app móvil.
# El JSON se coloca en ./runtime/storage-app/ del VM (montado en /var/www/storage/app).
FIREBASE_CREDENTIALS=/var/www/storage/app/firebase-service-account.json
FIREBASE_PROJECT_ID=mango-broker

# Des-mockeo del matcheo de Customer: en prod, linking estricto por DNI.
MANGO_MOCK_CUSTOMER_MATCHING=false
MANGO_DEFAULT_PAS_EMAIL=

# Visred API (cotización + emisión real).
VISRED_BASE_URL=https://api.visred.com.ar
VISRED_USERNAME=
VISRED_PASSWORD=
VISRED_TIMEOUT=30
VISRED_POLL_BUDGET=120
VISRED_POLL_INTERVAL=4
VISRED_SANDBOX=false

# AFIP / ARCA — Facturación electrónica de comisiones.
# .crt y .key van en ./runtime/storage-app/certs/ del VM (montado en /var/www/storage/app/certs).
AFIP_CUIT=
AFIP_PUNTO_VENTA=2
AFIP_HOMOLOGACION=false
AFIP_CERT_PATH=/var/www/storage/app/certs/afip.crt
AFIP_KEY_PATH=/var/www/storage/app/certs/afip.key
AFIP_KEY_PASSPHRASE=
